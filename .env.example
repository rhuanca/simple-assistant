TELEGRAM_BOT_TOKEN=your-token-here
GEMINI_API_KEY=your-gemini-api-key-here
BOT_PASSWORD=choose-a-secret-password

# Optional: LangSmith tracing. Get a free API key at https://smith.langchain.com
# When enabled, every call to run() becomes a clickable trace in the LangSmith UI
# with the full LLM/tool cascade inside. Privacy note: prompts (Telegram message
# text, grocery items, user names) are sent to LangSmith's servers.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=grocery-bot
